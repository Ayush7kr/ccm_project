# ========================================================
# CCM — Campaign Call Manager Environment Configuration
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# ========================================================

# Django Core
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,ccm.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://ccm.yourdomain.com

# Database (PostgreSQL Production)
# Option 1: Full connection URL
DATABASE_URL=postgresql://ccm_user:securepassword@db:5432/ccm_db

# Option 2: Individual variables (used when DATABASE_URL is not provided)
DB_ENGINE=postgresql
DB_NAME=ccm_db
DB_USER=ccm_user
DB_PASSWORD=securepassword
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Cookie & Session Security
SESSION_COOKIE_AGE=86400
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# HSTS Security Headers (HTTPS only)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# Email Configuration (Password Resets & Notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@ccm.local
